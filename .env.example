# Copy to .env and fill in. .env is gitignored - never commit credentials.
ANKIWEB_USERNAME=your-ankiweb-username-or-email
ANKIWEB_PASSWORD=your-ankiweb-password
# Private throwaway add-on used for upload tests (local and CI runners).
# Page: https://ankiweb.net/shared/info/805854302
# Never test uploads against a real add-on id - uploads are irreversible.
ANKIWEB_TEST_ADDON_ID=805854302